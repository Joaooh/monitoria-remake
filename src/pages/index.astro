---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import Impacto from "../components/home/Impacto.astro";
import Stats from "../components/home/Stats.astro";
import Iniciativas from "../components/home/Iniciativas.astro";
import PlaylistBanner from "../components/home/PlaylistBanner.astro";
import Sobre from "../components/home/Sobre.astro";
import Faq from "../components/home/Faq.astro";
import Footer from "../components/common/Footer.astro";
---

<Layout title="Monitoria de TI - CEUB">
  <main id="main-content">
    <Hero />
    <Impacto />
    <Iniciativas />
    <PlaylistBanner />
    <Sobre />
    <Stats />
    <Faq />
    <Footer />
  </main>
</Layout>

<style>
  main {
    width: 100%;
    overflow-x: hidden;
  }
</style>
